		)
	)
	(text "USB-B -> 500 mA PTC + USBLC6 ESD -> +5V.\n+5V -> TLV75901 (100k/20k feedback) -> +3V3.\n+5V -> IB0505LS-1WR3 isolated DC-DC -> +5V_ISO / GND_ISO (DVM side)."
		(exclude_from_sim no)
		(at 130 42 0)
		(effects
			(font
