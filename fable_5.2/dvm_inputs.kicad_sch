	(text "R24: connector shell / jackscrews to GND_ISO.\nSKB pin 37 = multimeter EARTH / logic 0.\nRemove R24 to float the shell."
		(exclude_from_sim no)
		(at 14 172 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "098f8551-08c4-56e6-8d1b-b041a4597434")
	)
	(text "J1 mounts on the BOTTOM side and plugs straight into\nthe \"Systems Interface\" socket SKB of the 70754 unit.\nPin numbers = SKB pin numbers (manual page 9.9)."
		(exclude_from_sim no)
		(at 14 52 0)
		(effects
			(font
				(size 1.3 1.3)
			)
			(justify left top)
		)
		(uuid "15ea696f-cfd2-537a-9457-056bce9be544")
	)
