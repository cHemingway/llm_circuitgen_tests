#pragma experiment("BRIDGE_CONNECT")
#pragma experiment("FOR_LOOP")

import ElectricPower
import ElectricLogic
import Electrical
import USB2_0
import SWD
import Capacitor
import Resistor

from "parts/Raspberry_Pi_RP2354A/Raspberry_Pi_RP2354A.ato" import Raspberry_Pi_RP2354A_package
from "parts/Abracon_LLC_ABM8_272_T3/Abracon_LLC_ABM8_272_T3.ato" import Abracon_LLC_ABM8_272_T3_package
from "parts/Abracon_LLC_AOTA_B201610S3R3_101_T/Abracon_LLC_AOTA_B201610S3R3_101_T.ato" import Abracon_LLC_AOTA_B201610S3R3_101_T_package
from "atopile/buttons/buttons.ato" import VerticalButton


module RP2354A:
    """
    Raspberry Pi RP2354A (QFN-60, 2 MB in-package flash) with the support
    circuitry from "Hardware design with RP2350" / RP2350 datasheet:
      - internal switching core regulator: 3.3 uH polarity-marked inductor,
        4.7 uF CIN / COUT, 33 R + 4.7 uF filter on VREG_AVDD
      - 12 MHz ABM8-272-T3 crystal, 15 pF load caps, 1 k series resistor
      - 27 R USB series termination
      - BOOTSEL button on QSPI_SS (via 1 k), RESET button on RUN
    No external flash: the RP2354A's flash is inside the package, the
    QSPI_SD*/QSPI_SCLK pins are left unconnected.
    """
    package = new Raspberry_Pi_RP2354A_package

    # --- External interfaces ---
    power = new ElectricPower
    """3.3 V supply (IOVDD, USB_OTP_VDD, ADC_AVDD, QSPI_IOVDD, VREG_VIN)"""
    assert power.voltage within 3.3V +/- 10%

    usb = new USB2_0
    """Full-speed USB device port (after 27 R termination)"""

    gpio = new ElectricLogic[30]
    """GPIO0..GPIO29, referenced to the 3.3 V IO supply"""

    swd = new SWD
    run = new ElectricLogic

    # --- Internal rails ---
    core = new ElectricPower
    """1.1 V core rail generated by the on-chip switching regulator"""
    core.lv ~ power.lv

    # --- Power pins ---
    package.IOVDD ~ power.hv
    package.USB_OTP_VDD ~ power.hv
    package.ADC_AVDD ~ power.hv
    package.QSPI_IOVDD ~ power.hv
    package.VREG_VIN ~ power.hv
    package.EP ~ power.lv
    package.VREG_PGND ~ power.lv
    package.DVDD ~ core.hv
    package.VREG_FB ~ core.hv

    # IOVDD (x6), USB_OTP_VDD, ADC_AVDD, QSPI_IOVDD decoupling: 100 nF per pin
    io_decoupling = new Capacitor[9]
    for c in io_decoupling:
        c.capacitance = 100nF +/- 20%
        c.package = "0402"
        c.lcsc_id = "C1525"
        power.hv ~> c ~> power.lv

    # DVDD (x3) decoupling
    core_decoupling = new Capacitor[3]
    for c in core_decoupling:
        c.capacitance = 100nF +/- 20%
        c.package = "0402"
        c.lcsc_id = "C1525"
        core.hv ~> c ~> core.lv

    # --- Core switching regulator ---
    vreg_inductor = new Abracon_LLC_AOTA_B201610S3R3_101_T_package
    """3.3 uH polarity-marked inductor. Orient the polarity dot as in
    RP2350 datasheet fig. 26/28 (current flows VREG_LX -> DVDD)."""
    package.VREG_LX ~ vreg_inductor.1
    vreg_inductor.2 ~ core.hv

    vreg_cin = new Capacitor
    vreg_cin.capacitance = 4.7uF +/- 20%
    vreg_cin.package = "0402"
    vreg_cin.lcsc_id = "C23733"
    package.VREG_VIN ~> vreg_cin ~> package.VREG_PGND

    vreg_cout = new Capacitor
    vreg_cout.capacitance = 4.7uF +/- 20%
    vreg_cout.package = "0402"
    vreg_cout.lcsc_id = "C23733"
    core.hv ~> vreg_cout ~> package.VREG_PGND

    vreg_avdd_r = new Resistor
    vreg_avdd_r.resistance = 33ohm +/- 5%
    vreg_avdd_r.package = "0402"
    vreg_avdd_r.lcsc_id = "C25105"
    vreg_avdd_c = new Capacitor
    vreg_avdd_c.capacitance = 4.7uF +/- 20%
    vreg_avdd_c.package = "0402"
    vreg_avdd_c.lcsc_id = "C23733"
    power.hv ~> vreg_avdd_r ~> package.VREG_AVDD
    package.VREG_AVDD ~> vreg_avdd_c ~> power.lv

    bulk = new Capacitor
    bulk.capacitance = 10uF +/- 20%
    bulk.package = "0603"
    bulk.lcsc_id = "C19702"
    power.hv ~> bulk ~> power.lv

    # --- 12 MHz crystal ---
    crystal = new Abracon_LLC_ABM8_272_T3_package
    crystal_load = new Capacitor[2]
    for c in crystal_load:
        c.capacitance = 15pF +/- 5%
        c.package = "0402"
        c.lcsc_id = "C1548"
    crystal_series_r = new Resistor
    crystal_series_r.resistance = 1kohm +/- 5%
    crystal_series_r.package = "0402"
    crystal_series_r.lcsc_id = "C11702"

    package.XIN ~ crystal.1
    package.XOUT ~> crystal_series_r ~> crystal.3
    crystal.GND ~ power.lv
    crystal.1 ~> crystal_load[0] ~> power.lv
    crystal.3 ~> crystal_load[1] ~> power.lv

    # --- USB ---
    usb_series_r = new Resistor[2]
    for r in usb_series_r:
        r.resistance = 27ohm +/- 5%
        r.package = "0402"
        r.lcsc_id = "C25100"
    usb.usb_if.d.p.line ~> usb_series_r[0] ~> package.USB_DP
    usb.usb_if.d.n.line ~> usb_series_r[1] ~> package.USB_DM
    usb.usb_if.buspower.lv ~ power.lv

    # --- BOOTSEL: pulls QSPI_SS low through 1 k while held during reset ---
    bootsel_button = new VerticalButton
    bootsel_r = new Resistor
    bootsel_r.resistance = 1kohm +/- 5%
    bootsel_r.package = "0402"
    bootsel_r.lcsc_id = "C11702"
    package.QSPI_SS ~> bootsel_r ~> bootsel_button ~> power.lv

    # --- RUN / reset ---
    reset_button = new VerticalButton
    run_pullup = new Resistor
    run_pullup.resistance = 10kohm +/- 5%
    run_pullup.package = "0402"
    run_pullup.lcsc_id = "C25744"
    run.reference ~ power
    run.line ~ package.RUN
    run.line ~> run_pullup ~> power.hv
    run.line ~> reset_button ~> power.lv

    # --- SWD ---
    swd.clk.line ~ package.SWCLK
    swd.dio.line ~ package.SWDIO
    swd.clk.reference ~ power
    swd.dio.reference ~ power

    # --- GPIO ---
    for io in gpio:
        io.reference ~ power

    gpio[0].line ~ package.GPIO0
    gpio[1].line ~ package.GPIO1
    gpio[2].line ~ package.GPIO2
    gpio[3].line ~ package.GPIO3
    gpio[4].line ~ package.GPIO4
    gpio[5].line ~ package.GPIO5
    gpio[6].line ~ package.GPIO6
    gpio[7].line ~ package.GPIO7
    gpio[8].line ~ package.GPIO8
    gpio[9].line ~ package.GPIO9
    gpio[10].line ~ package.GPIO10
    gpio[11].line ~ package.GPIO11
    gpio[12].line ~ package.GPIO12
    gpio[13].line ~ package.GPIO13
    gpio[14].line ~ package.GPIO14
    gpio[15].line ~ package.GPIO15
    gpio[16].line ~ package.GPIO16
    gpio[17].line ~ package.GPIO17
    gpio[18].line ~ package.GPIO18
    gpio[19].line ~ package.GPIO19
    gpio[20].line ~ package.GPIO20
    gpio[21].line ~ package.GPIO21
    gpio[22].line ~ package.GPIO22
    gpio[23].line ~ package.GPIO23
    gpio[24].line ~ package.GPIO24
    gpio[25].line ~ package.GPIO25
    gpio[26].line ~ package.GPIO26_ADC0
    gpio[27].line ~ package.GPIO27_ADC1
    gpio[28].line ~ package.GPIO28_ADC2
    gpio[29].line ~ package.GPIO29_ADC3
