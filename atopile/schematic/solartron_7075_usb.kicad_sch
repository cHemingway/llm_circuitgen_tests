			)
		)
	)
	(text "RP2354A (2 MB in-package flash). Core regulator per RP2350 datasheet:\n3.3 uH polarity-marked inductor, 4.7 uF CIN/COUT, 33R + 4.7 uF on VREG_AVDD.\nGPIO16 MISO, GPIO17 LATCH, GPIO18 SCK, GPIO19 MOSI, GPIO20 OE_N, GPIO21 DRDY, GPIO25 status LED."
		(exclude_from_sim no)
		(at 130 87 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
