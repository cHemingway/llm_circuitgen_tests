	(text "Six non-inverting TLP2361 channels. The LED cathode is driven by the source,\nthe anode is fed through 330R (3.3 V side) or 680R (5 V side), ~4.5 mA.\nUndriven inputs leave the outputs HIGH (OE_N_ISO high = 595 outputs Hi-Z)."
		(exclude_from_sim no)
		(at 130 132 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
